# HTTP basic-auth credentials for the /dev develop-branch preview.
#
# The preview proxies to the `dev` Docker target, which runs Django with
# DEBUG=True and `runserver`, so /dev is kept behind this auth file and is
# never a public endpoint. nginx fails closed (HTTP 500) for /dev until a real
# deploy/nginx/dev.htpasswd exists.
#
# Create the real file on the host:
#   htpasswd -c deploy/nginx/dev.htpasswd previewuser
#
# ...or without apache2-utils installed:
#   docker run --rm httpd:alpine htpasswd -nbB previewuser 'CHANGE_ME' \
#     > deploy/nginx/dev.htpasswd
#
# The line below is a non-working placeholder — replace it entirely.
previewuser:$apr1$PLACEHOLD$PLACEHOLDplaceholdplace0
