# Optional ACMAD Heat and Thermal Stress image synchronization
ACMAD_HEAT_STRESS_AUTO_IMPORT=False
ACMAD_HEAT_STRESS_IMPORT_INTERVAL_HOURS=6
ACMAD_HEAT_STRESS_IMPORT_LIMIT=3

# Volumes
CMS_DB_VOLUME=
BACKUP_VOLUME=
CMS_STATIC_VOLUME=
CMS_MEDIA_VOLUME=

# Volumes (prod profile only — see docker-compose.yml climweb_*_prod services)
CMS_DB_VOLUME_PROD=
BACKUP_VOLUME_PROD=

# Nginx (prod profile only)
# Set NGINX_CONFIG_PROD=nginx.prod.ssl.conf to serve over HTTPS. Requires
# copying deploy/nginx/ssl/ssl.conf.sample to ssl.conf, editing in your real
# domain's certificate paths, and pointing LETSENCRYPT_DIR at the host
# directory holding those certs (certbot's default is /etc/letsencrypt).
NGINX_CONFIG_PROD=
LETSENCRYPT_DIR=

# Shared webroot for certbot's HTTP-01 renewal challenge (see nginx.prod.ssl.conf)
CERTBOT_WEBROOT_DIR=

# You can find your uid and gid by running the `id` command.
UID=
GID=
