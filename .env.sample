# Django
SECRET_KEY=
CMS_DEBUG=False

CMS_BASE_URL=
CMS_SITE_NAME=
CMS_ADMIN_URL_PATH=cms-admin
TIME_ZONE=UTC

# ACMAD product bootstrap and automatic synchronization.
ACMAD_INITIAL_IMPORT_ON_STARTUP=False
ACMAD_MULTIHAZARD_AUTO_IMPORT=False
ACMAD_MULTIHAZARD_IMPORT_INTERVAL_HOURS=6
ACMAD_MULTIHAZARD_IMPORT_LIMIT=10
ACMAD_RAINFALL_AUTO_IMPORT=False
ACMAD_RAINFALL_IMPORT_INTERVAL_HOURS=6
ACMAD_RAINFALL_IMPORT_LIMIT=7
ACMAD_DEKADAL_AUTO_IMPORT=False
ACMAD_DEKADAL_IMPORT_INTERVAL_HOURS=24
ACMAD_POLICY_BRIEFS_AUTO_IMPORT=False
ACMAD_POLICY_BRIEFS_IMPORT_INTERVAL_HOURS=24
ACMAD_POLICY_BRIEFS_IMPORT_LIMIT=5
ACMAD_ATMOSPHERIC_ANALYSIS_AUTO_IMPORT=False
ACMAD_ATMOSPHERIC_ANALYSIS_IMPORT_INTERVAL_HOURS=6
ACMAD_ITD_ITCZ_AUTO_IMPORT=False
ACMAD_ITD_ITCZ_IMPORT_INTERVAL_HOURS=6
ACMAD_ITD_ITCZ_IMPORT_LIMIT=3
ACMAD_NOWCASTING_AUTO_IMPORT=False
ACMAD_NOWCASTING_IMPORT_INTERVAL_HOURS=1
ACMAD_NOWCASTING_IMPORT_LIMIT=3
ACMAD_CLIMATE_HEALTH_AUTO_IMPORT=False
ACMAD_CLIMATE_HEALTH_IMPORT_INTERVAL_HOURS=24
ACMAD_CLIMATE_HEALTH_IMPORT_LIMIT=5
ACMAD_SEASONAL_FORECAST_AUTO_IMPORT=False
ACMAD_SEASONAL_FORECAST_IMPORT_INTERVAL_HOURS=24
ACMAD_SEASONAL_FORECAST_IMPORT_LIMIT=5
